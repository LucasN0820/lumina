# Windows junctions, which cannot be recreated in EAS CLI's temporary archive.
.agents/
.claude/

# EAS builds only the mobile workspace. Exclude VCS metadata, documentation,
# editor settings, and unrelated applications from the upload and Bun install.
.git
.github/
.vscode/
docs/
apps/landing/*
!apps/landing/package.json
apps/server/*
!apps/server/package.json
config/
