{
  "name": "@lumina/workspace",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check": "bun run i18n:compile && vp check",
    "fmt": "vp fmt",
    "lint": "vp lint",
    "dev": "vp run dev:all",
    "test": "vp run test:all",
    "test:server": "vp test run apps/server/src",
    "build": "vp run build:all",
    "staged": "vp staged",
    "setup:hooks": "vp config --no-agent",
    "i18n:extract": "bun --filter=@lumina/i18n run extract",
    "i18n:compile": "bun --filter=@lumina/i18n run compile",
    "i18n:check": "bun run i18n:extract && git diff --exit-code -- packages/i18n/locales && bun run i18n:compile"
  },
  "dependencies": {
    "expo-image-picker": "~56.0.22"
  },
  "devDependencies": {
    "@voidzero-dev/vite-plus-core": "^0.2.6",
    "vite-plus": "^0.2.6",
    "vitest": "4.1.10"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@latest"
  },
  "packageManager": "bun@1.3.11"
}
